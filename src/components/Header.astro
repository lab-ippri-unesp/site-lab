---
import { t, LANGUAGES, LANG_LABEL, type Lang } from '~/i18n/translations';
import { localizedPath } from '~/utils/paths';
import ThemeToggle from '~/components/ThemeToggle.astro';
import LogoMark from '~/components/LogoMark.astro';

interface Props {
  lang: Lang;
  pathInLang?: string;
  /** Idiomas em que a página atual existe; demais idiomas levam à home. */
  availableLangs?: Lang[];
}
const { lang, pathInLang = '', availableLangs = [...LANGUAGES] } = Astro.props;

const navItems = [
  { href: localizedPath(lang, 'sobre'), label: t(lang, 'nav.about') },
  { href: localizedPath(lang, 'equipamentos'), label: t(lang, 'nav.equipment') },
  { href: localizedPath(lang, 'equipe'), label: t(lang, 'nav.team') },
  { href: localizedPath(lang, 'noticias'), label: t(lang, 'nav.news') },
  { href: localizedPath(lang, 'acesso'), label: t(lang, 'nav.access') },
];
---

<header class="sticky top-0 z-30 shadow-sm">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(240px,26%)_1fr]">
    <!-- coluna do logo: símbolo + wordmark da identidade -->
    <div class="bg-base-100 flex items-center justify-center lg:justify-start px-6 py-3">
      <a
        href={localizedPath(lang, '')}
        class="flex items-center gap-3"
        aria-label={`${t(lang, 'site.title')} — ${t(lang, 'nav.home')}`}
      >
        <LogoMark class="h-10 w-10 shrink-0" />
        <span class="leading-tight">
          <span class="block font-display text-base font-bold text-primary">
            Laboratório Multiusuário
          </span>
          <span class="block text-[0.7rem] uppercase tracking-[0.18em] opacity-60">
            {t(lang, 'site.institution')}
          </span>
        </span>
      </a>
    </div>

    <!-- coluna do menu (gradiente de marca) -->
    <div class="brand-gradient text-white">
      <div
        class="flex items-center gap-1 h-full px-4 lg:px-6 py-2 lg:py-0 justify-end lg:justify-between"
      >
        <nav
          class="hidden lg:flex items-center gap-1 overflow-x-auto"
          aria-label={t(lang, 'a11y.nav_main')}
        >
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="px-3 py-2 text-sm font-medium uppercase tracking-wide whitespace-nowrap rounded hover:bg-white/10 hover:underline underline-offset-8 decoration-2"
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-1 ml-auto">
          <a
            href={localizedPath(lang, 'busca')}
            class="btn btn-ghost btn-sm text-white hover:bg-white/10"
            aria-label={t(lang, 'nav.search')}
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </a>

          <div class="dropdown dropdown-end">
            <button
              class="btn btn-ghost btn-sm text-white hover:bg-white/10"
              aria-label={t(lang, 'nav.language')}
            >
              {lang.toUpperCase()}
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <ul
              class="dropdown-content menu bg-base-100 text-base-content rounded-box shadow border border-base-300 mt-2 w-40 z-40"
            >
              {
                LANGUAGES.map((l) => (
                  <li>
                    <a
                      href={localizedPath(l, availableLangs.includes(l) ? pathInLang : '')}
                      aria-current={l === lang ? 'true' : undefined}
                    >
                      {LANG_LABEL[l]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <ThemeToggle lang={lang} />

          <details class="dropdown dropdown-end lg:hidden">
            <summary class="btn btn-ghost btn-sm text-white hover:bg-white/10" aria-label="Menu">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </summary>
            <ul
              class="dropdown-content menu bg-base-100 text-base-content rounded-box shadow border border-base-300 mt-2 w-60 z-40"
            >
              {
                navItems.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>
      </div>
    </div>
  </div>
</header>

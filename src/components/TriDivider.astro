---
/**
 * Divisor triangular entre seções — o canto do logo vira o "corte" da página.
 * Dentes na cor da marca apontando para baixo, sobre o fundo da seção de baixo.
 * Decorativo (aria-hidden). `gid` deve ser único por instância na página.
 */
interface Props {
  /** cor de fundo (= cor da seção logo abaixo) */
  bg?: string;
  gid: string;
  height?: number;
  cell?: number;
  class?: string;
}
const { bg = 'var(--color-base-100)', gid, height = 44, cell = 64, class: cls = '' } = Astro.props;
const W = 1200;

const teeth: { p: string; fill: string; op?: number }[] = [];
for (let x = 0; x < W; x += cell) {
  teeth.push({ p: `${x},0 ${x + cell},0 ${x + cell / 2},${height}`, fill: `url(#${gid})` });
  teeth.push({
    p: `${x + cell / 2},${height} ${x + cell},0 ${x + cell},${height}`,
    fill: 'var(--color-accent)',
    op: 0.9,
  });
}
---

<div class={`tridiv ${cls}`} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${height}`} preserveAspectRatio="none" width="100%" height={height}>
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#7A2E2C"></stop>
        <stop offset="1" stop-color="#3A1715"></stop>
      </linearGradient>
    </defs>
    <rect width={W} height={height} fill={bg}></rect>
    {teeth.map((t) => <polygon points={t.p} fill={t.fill} fill-opacity={t.op ?? 1} />)}
  </svg>
</div>

<style>
  .tridiv {
    line-height: 0;
  }
  .tridiv svg {
    display: block;
  }
</style>

---
/**
 * "Malha de dados viva" do hero: a tesselação triangular do logo cobre o fundo,
 * mais densa na âncora (canto superior-esquerdo) e esvaindo para a direita.
 * Todos os triângulos se montam no carregamento; os "acesos" (acento) pulsam.
 * Decorativo (aria-hidden) e gentil com prefers-reduced-motion.
 */
import { meshField } from '~/lib/geo';

const W = 1200;
const H = 480;
const CELL = 56;
const LIT_EVERY = 13;
const tris = meshField(W, H, CELL);

function meta(t: { cx: number; cy: number }, idx: number) {
  const nx = t.cx / W;
  const ny = t.cy / H;
  let base = 0.3 * (1 - (0.55 * nx + 0.7 * ny));
  if (base < 0.03) base = 0.03;
  // banda do texto (esquerda): mantém sutil para legibilidade
  if (t.cx > 60 && t.cx < 760 && t.cy > 110 && t.cy < 330) base *= 0.45;
  const lit = idx % LIT_EVERY === 0 && nx < 0.85;
  return { base: lit ? 0.5 : base, lit };
}
---

<svg
  class="heromesh"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  {
    tris.map((t, idx) => {
      const m = meta(t, idx);
      const dur = (2.6 + (idx % 5) * 0.5).toFixed(2);
      return (
        <polygon
          points={t.pts}
          class={m.lit ? 'tri tri--lit' : 'tri'}
          fill-opacity={m.base.toFixed(3)}
          style={`--i:${idx}; --dur:${dur}s;`}
        />
      );
    })
  }
</svg>

<style>
  .heromesh {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .tri {
    fill: #fff;
    transform-box: fill-box;
    transform-origin: center;
  }
  .tri--lit {
    fill: #e9b8ac;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tri {
      animation: hm-in 600ms cubic-bezier(0.2, 0.7, 0.3, 1) backwards;
      animation-delay: calc(var(--i) * 4ms);
    }
    /* só os "acesos" pulsam continuamente (custo baixo) */
    .tri--lit {
      animation:
        hm-in 600ms cubic-bezier(0.2, 0.7, 0.3, 1) backwards,
        hm-shimmer var(--dur) ease-in-out infinite;
      animation-delay: calc(var(--i) * 4ms), calc(900ms + var(--i) * 6ms);
    }
  }
  @keyframes hm-in {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes hm-shimmer {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
</style>

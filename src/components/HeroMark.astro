---
/**
 * Marca triangular do laboratório (motivo do letreiro / favicon) no hero, em
 * tratamento "mosaico tonal": triângulos em tons variados de branco, com a
 * diagonal em rosé da identidade. Montam-se no carregamento e depois uma onda
 * de brilho percorre o mosaico. Decorativo (aria-hidden) e gentil com
 * prefers-reduced-motion (mosaico estático quando reduzido).
 */
import { logoCornerCells } from '~/lib/geo';

const N = 5; // malha mais rica que a da marca (N=4) — mesmo motivo, mais detalhe
const cells = logoCornerCells(100, N);

const ROSE = '#E9B8AC';
const tone = (r: number) => Math.max(0.35, 1 - r * 0.13);
---

<svg class="heromark" viewBox="0 0 100 100" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  {
    cells.map((t, i) => (
      <polygon
        points={t.pts}
        class="tri"
        fill={t.r === t.c ? ROSE : '#ffffff'}
        style={`--i:${i}; --d:${t.r + t.c}; --base:${tone(t.r).toFixed(2)}`}
      />
    ))
  }
</svg>

<style>
  .heromark {
    display: block;
    width: clamp(170px, 24vw, 300px);
    height: auto;
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.18));
  }
  .tri {
    opacity: var(--base);
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tri {
      animation:
        hm-in 560ms cubic-bezier(0.2, 0.7, 0.3, 1) calc(var(--i) * 55ms) backwards,
        hm-wave 5.2s ease-in-out calc(1300ms + var(--d) * 240ms) infinite;
    }
  }
  @keyframes hm-in {
    from {
      opacity: 0;
      transform: scale(0.35);
    }
    to {
      opacity: var(--base);
      transform: scale(1);
    }
  }
  /* onda diagonal de brilho: cada triângulo acende na sua vez (fase = r+c) */
  @keyframes hm-wave {
    0%,
    18%,
    100% {
      opacity: var(--base);
    }
    8% {
      opacity: 1;
    }
  }
</style>

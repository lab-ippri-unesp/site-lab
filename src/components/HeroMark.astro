---
/**
 * Marca triangular do laboratório (motivo do letreiro / favicon) no hero, em
 * estilo "wireframe": triângulos de contorno que se DESENHAM no carregamento,
 * com alguns preenchidos que depois respiram. Decorativo e gentil com
 * prefers-reduced-motion (estática, já desenhada/preenchida, quando reduzido).
 */
import { logoCorner } from '~/lib/geo';

const tris = logoCorner(100, 'tl', 4);
const filled = (i: number) => i % 4 === 0;
---

<svg class="heromark" viewBox="0 0 100 100" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  {
    tris.map((p, i) => (
      <polygon
        points={p}
        class={filled(i) ? 'tri tri--fill' : 'tri'}
        pathLength="100"
        style={`--i:${i}`}
      />
    ))
  }
</svg>

<style>
  .heromark {
    display: block;
    width: clamp(170px, 24vw, 300px);
    height: auto;
    overflow: visible;
  }
  .tri {
    fill: none;
    stroke: #ffffff;
    stroke-width: 2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .tri--fill {
    fill: rgba(255, 255, 255, 0.92);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tri {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: hm-draw 700ms ease calc(var(--i) * 85ms) forwards;
    }
    .tri--fill {
      fill: rgba(255, 255, 255, 0);
      animation:
        hm-draw 700ms ease calc(var(--i) * 85ms) forwards,
        hm-fill 520ms ease calc(900ms + var(--i) * 85ms) forwards,
        hm-breath 4.2s ease-in-out calc(1700ms + var(--i) * 85ms) infinite;
    }
  }
  @keyframes hm-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes hm-fill {
    to {
      fill: rgba(255, 255, 255, 0.92);
    }
  }
  @keyframes hm-breath {
    0%,
    100% {
      fill: rgba(255, 255, 255, 0.92);
    }
    50% {
      fill: rgba(255, 255, 255, 0.5);
    }
  }
</style>

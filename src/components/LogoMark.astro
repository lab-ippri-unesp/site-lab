---
/**
 * Símbolo da marca em SVG inline (para animar a "montagem" dos triângulos no
 * carregamento). Cores fixas da identidade (não seguem o tema) para manter a
 * leitura da marca em qualquer fundo.
 */
import { logoCorner } from '~/lib/geo';

interface Props {
  class?: string;
  title?: string;
}
const { class: cls = '', title = 'Laboratório Multiusuário IPPRI' } = Astro.props;
const tris = logoCorner(64, 'tl', 4);
---

<svg
  class={`logomark ${cls}`}
  viewBox="0 0 100 100"
  role="img"
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="100" height="100" rx="22" fill="#7A2E2C"></rect>
  <g transform="translate(18,18)">
    {tris.map((p, i) => <polygon points={p} class="tri" style={`--i:${i}`} fill="#fff"></polygon>)}
  </g>
</svg>

<style>
  .tri {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tri {
      animation: mark-in 520ms cubic-bezier(0.2, 0.7, 0.3, 1) backwards;
      animation-delay: calc(var(--i) * 45ms);
    }
  }
  @keyframes mark-in {
    from {
      opacity: 0;
      transform: scale(0.2) rotate(-8deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import EquipamentoCard from '~/components/EquipamentoCard.astro';
import { LANGUAGES, t, type Lang } from '~/i18n/translations';
import { entrySlug } from '~/utils/content';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

let equipamentos = await getCollection('equipamentos', (e) => e.data.lang === lang);
const fallbackPt = lang !== 'pt' && equipamentos.length === 0;
if (fallbackPt) {
  equipamentos = await getCollection('equipamentos', (e) => e.data.lang === 'pt');
}
equipamentos.sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order
);
const itemLang = fallbackPt ? 'pt' : lang;
---

<BaseLayout
  lang={lang}
  title={t(lang, 'equipment.title')}
  description={t(lang, 'equipment.intro')}
  pathInLang="equipamentos"
>
  <section class="container mx-auto px-4 py-12">
    <Breadcrumbs lang={lang} trail={[{ label: t(lang, 'equipment.title') }]} />
    <h1 class="text-3xl md:text-4xl font-bold">{t(lang, 'equipment.title')}</h1>
    <p class="opacity-80 mt-3 text-lg max-w-3xl">{t(lang, 'equipment.intro')}</p>

    {
      equipamentos.length === 0 ? (
        <p class="opacity-70 mt-10">{t(lang, 'equipment.empty')}</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-10">
          {equipamentos.map((e) => (
            <EquipamentoCard
              lang={itemLang}
              headingLevel="h2"
              slug={entrySlug(e)}
              name={e.data.name}
              category={e.data.category}
              summary={e.data.summary}
              image={e.data.image}
              status={e.data.status}
            />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
